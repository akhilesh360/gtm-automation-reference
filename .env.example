# ---- Core (no credentials needed) ----
DUCKDB_PATH=data/gtm.duckdb
RANDOM_SEED=42
LOG_LEVEL=INFO

# ---- Salesforce integration layer (optional) ----
# SF_ENABLED=true switches from MockSalesforceClient to simple-salesforce.
# With SF_ENABLED=false all writes go to data/processed/mock_salesforce.json
SF_ENABLED=false
# SF_AUTH=cli reuses the session from `sf org login web -a gtm-dev` (recommended, no password stored).
# SF_AUTH=password uses the three credential fields below.
SF_AUTH=cli
SF_ALIAS=gtm-dev
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=login

# ---- Optional AI-assisted drafting ----
# AI_ENABLED=true and a key -> one Claude call per Tier 1 account drafts narrative, task description, outbound draft.
# Off -> deterministic templates. The project runs fully without a key.
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- ERP handoff (v2) ----
# Empty = in-process NetSuite-style mock (data/processed/mock_netsuite.json).
# Set to http://127.0.0.1:8100 after `uvicorn erp.mock_server:app --port 8100` to hand off over HTTP.
ERP_URL=

# ---- Live connectors (v2, optional) ----
# CLAY_ENABLED=true registers POST /webhooks/clay on the API. In Clay, add a "Send to HTTP API" action pointing at
# https://<your-public-host>/webhooks/clay with header X-Clay-Secret: <CLAY_WEBHOOK_SECRET>. CSV export remains the default.
CLAY_ENABLED=false
CLAY_WEBHOOK_SECRET=
# HUBSPOT_ENABLED=true pulls email and meeting engagements from the HubSpot CRM API (service key or private-app token,
# scopes crm.objects.contacts.read + sales-email-read) into data/processed/hubspot_engagement_live.csv, loaded in addition
# to the seeded export. CSV export remains the default.
HUBSPOT_ENABLED=false
HUBSPOT_TOKEN=
HUBSPOT_LOOKBACK_DAYS=90
